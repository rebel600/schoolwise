# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# Frontend variables are bundled into client JavaScript and are therefore
# PUBLIC. Never put a secret behind a VITE_ prefix.

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Backend (packages/backend — not yet implemented)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://schoolwise_app:password@localhost:5432/schoolwise
#
# The application connects as a NON-OWNING role without BYPASSRLS, so
# Row-Level Security actually applies. Migrations run as a separate owner
# role. See docs/06-multi-tenancy.md.
# DATABASE_MIGRATION_URL=postgresql://schoolwise_owner:password@localhost:5432/schoolwise

# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# CORS_ORIGINS=http://localhost:9000
# LOG_LEVEL=debug
