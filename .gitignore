# ===========================================================================
# NEVER COMMIT — data and secrets
#
# This platform stores personal data about minors, across multiple tenants.
# A committed database dump is a data breach, not an untidy repository, and
# git history makes it very hard to take back. These patterns come first
# because they are the ones with consequences.
# ===========================================================================

# Environment. Commit .env.example instead.
.env
.env.*
!.env.example

# Database dumps and local databases.
# Narrow on purpose: migrations are NNNN_name.sql and must stay tracked.
*.dump
*.sqlite
*.sqlite3
*.db
dump*.sql
backup*.sql
*.backup.sql
pgdata/

# Uploaded files — student photos, documents, certificates.
uploads/
storage/

# Keys, certificates, and cloud credentials.
*.pem
*.key
*.p12
*.pfx
*-credentials.json
service-account*.json
.npmrc

# ===========================================================================
# Generated output
# ===========================================================================

node_modules

dist
build
*.tsbuildinfo

# Turborepo, including the per-package caches
.turbo

# Vite writes these beside a config file when it transpiles it
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Generated by `build:css` / `dev:css` — never commit.
packages/styleguide/src/tailwind-gen.css

# ===========================================================================
# Test output
# ===========================================================================

coverage
test-results
playwright-report
blob-report
playwright/.cache
.last-run.json

# ===========================================================================
# Logs and scratch files
# ===========================================================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Left behind by failed merges and applied patches
*.orig
*.rej

# ===========================================================================
# Editors and tooling
#
# .vscode is allow-listed rather than ignored: shared debug configs and
# recommended extensions are worth committing; personal preferences are not.
# ===========================================================================

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea

# Claude Code. `.claude/settings.json` and `CLAUDE.md` are SHARED project
# config and belong in the repo; these two are per-developer.
.claude/settings.local.json
.claude/skills
skills-lock.json

# ===========================================================================
# OS
# ===========================================================================

.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
