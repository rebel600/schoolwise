# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# Frontend variables are bundled into client JavaScript and are therefore
# PUBLIC. Never put a secret behind a VITE_ prefix.

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Backend — packages/backend
# ---------------------------------------------------------------------------

# The application connects as a NON-OWNING role without BYPASSRLS, so
# Row-Level Security actually applies. Migrations run as the owner.
# See docs/06-multi-tenancy.md.
DATABASE_URL=postgresql://schoolwise_app:app_dev_password@localhost:5432/schoolwise
DATABASE_MIGRATION_URL=postgresql://schoolwise_owner:schoolwise_dev_password@localhost:5432/schoolwise

# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:9000
LOG_LEVEL=debug

# Where password-reset links point — the FRONTEND origin, not the API.
APP_BASE_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty in development: emails are written to the API log
# instead of sent, so the reset link is still usable without a mail account.
# In PRODUCTION an empty SMTP_HOST is a startup error — otherwise reset links
# would be silently logged rather than delivered.
#
# SMTP works with every provider. Examples:
#
#   Gmail        host smtp.gmail.com          port 587
#                Requires an App Password, NOT your account password:
#                https://myaccount.google.com/apppasswords
#                (needs 2-Step Verification enabled first)
#
#   Resend       host smtp.resend.com         port 587   user "resend"
#   SendGrid     host smtp.sendgrid.net       port 587   user "apikey"
#   Mailgun      host smtp.mailgun.org        port 587
#   Mailtrap     host sandbox.smtp.mailtrap.io port 2525  (catches everything —
#                the safest choice while testing, since nothing reaches a
#                real inbox)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SchoolWise <no-reply@schoolwise.local>
